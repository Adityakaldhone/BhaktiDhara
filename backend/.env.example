# Google Gemini API Key (keep this private on your Hetzner server!)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini free-tier budget. GEMINI_RPM caps ALL calls per minute (users + precache);
# the nightly precache uses at most PRECACHE_RPM of it so users keep the rest.
GEMINI_RPM=10
PRECACHE_RPM=5

# Secret token for viewing the /api/v1/admin/stats dashboard
ADMIN_SECRET=change_this_to_a_secure_random_string

# Firebase push notifications: download the service account key from
# Firebase console → Project settings → Service accounts → Generate new private key
# and save it as ./data/firebase-service-account.json (mounted at the path below).
FIREBASE_SERVICE_ACCOUNT=/app/data/firebase-service-account.json

# Server Port
PORT=8000
HOST=0.0.0.0
